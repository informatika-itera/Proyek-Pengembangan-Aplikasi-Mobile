CREATE TABLE BookEntity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  author TEXT NOT NULL DEFAULT '',
  cover_url TEXT NOT NULL DEFAULT '',
  category TEXT NOT NULL DEFAULT 'FICTION',
  color TEXT NOT NULL DEFAULT 'DEFAULT',
  total_pages INTEGER NOT NULL DEFAULT 0,
  is_pinned INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE AIRecommendation (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  book_id INTEGER NOT NULL UNIQUE, -- Tambahkan UNIQUE agar INSERT OR REPLACE berfungsi
  recommendation_text TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  FOREIGN KEY (book_id) REFERENCES BookEntity(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_book_entity_pinned ON BookEntity(is_pinned);
CREATE INDEX IF NOT EXISTS idx_book_entity_user ON BookEntity(user_id);
CREATE INDEX IF NOT EXISTS idx_ai_recommendation_book_id ON AIRecommendation(book_id);

-- Book Queries
getAllNotes:
SELECT * FROM BookEntity
ORDER BY is_pinned DESC, updated_at DESC;

getNotesByUser:
SELECT * FROM BookEntity
WHERE user_id = ?
ORDER BY is_pinned DESC, updated_at DESC;

getPinnedNotes:
SELECT * FROM BookEntity
WHERE is_pinned = 1
ORDER BY updated_at DESC;

getNotesByCategory:
SELECT * FROM BookEntity
WHERE category = ?
ORDER BY is_pinned DESC, updated_at DESC;

searchNotes:
SELECT * FROM BookEntity
WHERE (title LIKE '%' || ? || '%'
   OR content LIKE '%' || ? || '%'
   OR author LIKE '%' || ? || '%')
ORDER BY is_pinned DESC, updated_at DESC;

getBookById:
SELECT * FROM BookEntity WHERE id = ?;

addBook:
INSERT INTO BookEntity (
  user_id, title, content, author, cover_url, category, color, total_pages, is_pinned, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updateBook:
UPDATE BookEntity
SET title = ?, content = ?, author = ?, cover_url = ?, category = ?, color = ?, total_pages = ?, is_pinned = ?, updated_at = ?
WHERE id = ?;

deleteNoteById:
DELETE FROM BookEntity WHERE id = ?;

togglePin:
UPDATE BookEntity
SET is_pinned = CASE WHEN is_pinned = 1 THEN 0 ELSE 1 END,
    updated_at = ?
WHERE id = ?;

deleteNotesByIds:
DELETE FROM BookEntity WHERE id IN ?;

-- AI Recommendation Queries
getRecommendationForBook:
SELECT * FROM AIRecommendation WHERE book_id = ?;

insertRecommendation:
INSERT OR REPLACE INTO AIRecommendation (
  book_id, recommendation_text, created_at
) VALUES (?, ?, ?);

deleteRecommendation:
DELETE FROM AIRecommendation WHERE book_id = ?;

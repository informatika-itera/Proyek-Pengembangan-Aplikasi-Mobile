-- Database schema for BridgeBit (Translation App)
-- File: BridgeBit.sq

CREATE TABLE TranslationEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    source_text TEXT NOT NULL,
    translated_text TEXT NOT NULL,
    source_language TEXT NOT NULL,
    target_language TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT 'Umum', -- KOLOM BARU
    is_vaulted INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

getAllHistory:
SELECT * FROM TranslationEntity
ORDER BY updated_at DESC;

searchHistory:
SELECT * FROM TranslationEntity
WHERE source_text LIKE '%' || ? || '%' OR translated_text LIKE '%' || ? || '%'
ORDER BY updated_at DESC;

getVaultPhrases:
SELECT * FROM TranslationEntity
WHERE is_vaulted = 1
ORDER BY updated_at DESC;

toggleVaultStatus:
UPDATE TranslationEntity
SET is_vaulted = CASE WHEN is_vaulted = 1 THEN 0 ELSE 1 END, updated_at = ?
WHERE id = ?;

getTranslationById:
SELECT * FROM TranslationEntity
WHERE id = ?;

insertTranslation:
INSERT INTO TranslationEntity (source_text, translated_text, source_language, target_language, category, is_vaulted, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updateTranslation:
UPDATE TranslationEntity
SET source_text = ?, translated_text = ?, source_language = ?, target_language = ?, category = ?, is_vaulted = ?, updated_at = ?
WHERE id = ?;

deleteTranslationById:
DELETE FROM TranslationEntity
WHERE id = ?;

deleteTranslationsByIds:
DELETE FROM TranslationEntity
WHERE id IN ?;
import kotlinx.datetime.Instant;

CREATE TABLE FoodItemEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    quantity REAL NOT NULL,
    unit TEXT NOT NULL,
    buyDate INTEGER AS Instant NOT NULL,
    expiryDate INTEGER AS Instant NOT NULL,
    category TEXT NOT NULL,
    storageLocation TEXT NOT NULL DEFAULT 'Kulkas',
    notes TEXT,
    isConsumed INTEGER NOT NULL DEFAULT 0
);

insertFoodItem:
INSERT OR REPLACE INTO FoodItemEntity(id, name, quantity, unit, buyDate, expiryDate, category, storageLocation, notes, isConsumed)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllFoodItems:
SELECT * FROM FoodItemEntity ORDER BY expiryDate ASC;

getFoodItemsByCategory:
SELECT * FROM FoodItemEntity WHERE category = ? ORDER BY expiryDate ASC;

getFoodItemById:
SELECT * FROM FoodItemEntity WHERE id = ?;

deleteFoodItem:
DELETE FROM FoodItemEntity WHERE id = ?;

updateFoodItem:
UPDATE FoodItemEntity
SET name = ?, quantity = ?, unit = ?, buyDate = ?, expiryDate = ?, category = ?, storageLocation = ?, notes = ?, isConsumed = ?
WHERE id = ?;

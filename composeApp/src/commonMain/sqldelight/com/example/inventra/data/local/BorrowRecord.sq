CREATE TABLE BorrowRecordEntity (
    id                INTEGER PRIMARY KEY AUTOINCREMENT,
    remote_id         TEXT,
    item_id           INTEGER NOT NULL,
    borrower_id       TEXT    NOT NULL DEFAULT '',
    item_name         TEXT    NOT NULL,
    borrower_name     TEXT    NOT NULL,
    borrower_division TEXT    NOT NULL DEFAULT '',
    borrow_date       INTEGER NOT NULL,
    due_date          INTEGER NOT NULL,
    return_date       INTEGER,
    status            TEXT    NOT NULL DEFAULT 'ACTIVE',
    fine_amount       INTEGER NOT NULL DEFAULT 0,
    return_proof_url  TEXT
);

getAllRecords:
SELECT * FROM BorrowRecordEntity ORDER BY borrow_date DESC;

getActiveRecords:
SELECT * FROM BorrowRecordEntity
WHERE status = 'ACTIVE' OR status = 'OVERDUE'
ORDER BY due_date ASC;

getPendingRecords:
SELECT * FROM BorrowRecordEntity WHERE status = 'PENDING' OR status = 'PENDING_RETURN' ORDER BY borrow_date DESC;

getRecordById:
SELECT * FROM BorrowRecordEntity WHERE id = ?;

getRecordByRemoteId:
SELECT * FROM BorrowRecordEntity WHERE remote_id = ?;

insertRecord:
INSERT INTO BorrowRecordEntity
    (remote_id, item_id, borrower_id, item_name, borrower_name, borrower_division, borrow_date, due_date, return_date, status, fine_amount, return_proof_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updateRemoteId:
UPDATE BorrowRecordEntity SET remote_id = ? WHERE id = ?;

updateRecordStatus:
UPDATE BorrowRecordEntity
SET status = ?, return_date = ?, fine_amount = ?, return_proof_url = ?
WHERE id = ?;

updateStatus:
UPDATE BorrowRecordEntity SET status = ? WHERE id = ?;

deleteRecord:
DELETE FROM BorrowRecordEntity WHERE id = ?;

deleteAll:
DELETE FROM BorrowRecordEntity;
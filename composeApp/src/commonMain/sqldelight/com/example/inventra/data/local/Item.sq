CREATE TABLE ItemEntity (
    id              INTEGER PRIMARY KEY AUTOINCREMENT,
    remote_id       TEXT,
    name            TEXT    NOT NULL,
    description     TEXT    NOT NULL DEFAULT '',
    category        TEXT    NOT NULL DEFAULT 'OTHER',
    location        TEXT    NOT NULL DEFAULT '',
    total_stock     INTEGER NOT NULL DEFAULT 1,
    available_stock INTEGER NOT NULL DEFAULT 1,
    condition       TEXT    NOT NULL DEFAULT 'GOOD',
    pic_name        TEXT    NOT NULL DEFAULT '',
    pic_phone       TEXT    NOT NULL DEFAULT '',
    image_url       TEXT,
    created_at      INTEGER NOT NULL,
    updated_at      INTEGER NOT NULL
);

getAllItems:
SELECT * FROM ItemEntity ORDER BY updated_at DESC;

getItemsByCategory:
SELECT * FROM ItemEntity WHERE category = ? ORDER BY updated_at DESC;

searchItems:
SELECT * FROM ItemEntity
WHERE name LIKE '%' || ? || '%' OR description LIKE '%' || ? || '%'
ORDER BY updated_at DESC;

getItemById:
SELECT * FROM ItemEntity WHERE id = ?;

getItemByRemoteId:
SELECT * FROM ItemEntity WHERE remote_id = ?;

insertItem:
INSERT INTO ItemEntity (remote_id, name, description, category, location,
    total_stock, available_stock, condition, pic_name, pic_phone, image_url,
    created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

updateItem:
UPDATE ItemEntity
SET name = ?, description = ?, category = ?, location = ?,
    total_stock = ?, available_stock = ?, condition = ?,
    pic_name = ?, pic_phone = ?, image_url = ?, updated_at = ?
WHERE id = ?;

updateRemoteId:
UPDATE ItemEntity SET remote_id = ? WHERE id = ?;

updateAvailableStock:
UPDATE ItemEntity
SET available_stock = ?, updated_at = ?
WHERE id = ?;

resetAllStocks:
UPDATE ItemEntity SET available_stock = total_stock, updated_at = ?;

deleteItem:
DELETE FROM ItemEntity WHERE id = ?;

countAll:
SELECT COUNT(*) FROM ItemEntity;

countAvailable:
SELECT COUNT(*) FROM ItemEntity WHERE available_stock > 0;

deleteAll:
DELETE FROM ItemEntity;
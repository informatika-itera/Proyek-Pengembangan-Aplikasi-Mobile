-- VulnLog table schema for SQLDelight
-- File: Note.sq

CREATE TABLE NoteEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    target_url TEXT NOT NULL DEFAULT '',
    vuln_type TEXT NOT NULL DEFAULT 'OTHER',
    color TEXT NOT NULL DEFAULT 'DEFAULT',
    severity TEXT NOT NULL DEFAULT 'NONE',
    status TEXT NOT NULL DEFAULT 'NEW',
    is_pinned INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

-- Get all logs ordered by updated_at descending
getAllNotes:
SELECT * FROM NoteEntity
ORDER BY is_pinned DESC, updated_at DESC;

-- Get pinned logs
getPinnedNotes:
SELECT * FROM NoteEntity
WHERE is_pinned = 1
ORDER BY updated_at DESC;

-- Get logs by vulnerability type
getNotesByVulnType:
SELECT * FROM NoteEntity
WHERE vuln_type = ?
ORDER BY is_pinned DESC, updated_at DESC;

-- Get logs by severity
getNotesBySeverity:
SELECT * FROM NoteEntity
WHERE severity = ?
ORDER BY is_pinned DESC, updated_at DESC;

-- Get logs by status
getNotesByStatus:
SELECT * FROM NoteEntity
WHERE status = ?
ORDER BY is_pinned DESC, updated_at DESC;

-- Search logs by title, content, or target_url
searchNotes:
SELECT * FROM NoteEntity
WHERE title LIKE '%' || ? || '%' OR content LIKE '%' || ? || '%' OR target_url LIKE '%' || ? || '%'
ORDER BY is_pinned DESC, updated_at DESC;

-- Get single log by ID
getNoteById:
SELECT * FROM NoteEntity
WHERE id = ?;

-- Insert new log
insertNote:
INSERT INTO NoteEntity (title, content, target_url, vuln_type, color, severity, status, is_pinned, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Get last inserted ID
lastInsertId:
SELECT last_insert_rowid();

-- Update existing log
updateNote:
UPDATE NoteEntity
SET title = ?, content = ?, target_url = ?, vuln_type = ?, color = ?, severity = ?, status = ?, is_pinned = ?, updated_at = ?
WHERE id = ?;

-- Delete log by ID
deleteNoteById:
DELETE FROM NoteEntity
WHERE id = ?;

-- Toggle pin status
togglePin:
UPDATE NoteEntity
SET is_pinned = CASE WHEN is_pinned = 1 THEN 0 ELSE 1 END, updated_at = ?
WHERE id = ?;

-- Delete multiple logs
deleteNotesByIds:
DELETE FROM NoteEntity
WHERE id IN ?;

-- Count all logs
countNotes:
SELECT COUNT(*) FROM NoteEntity;

-- Count logs by severity
countNotesBySeverity:
SELECT severity, COUNT(*) AS total
FROM NoteEntity
GROUP BY severity;

-- Count logs by status
countNotesByStatus:
SELECT status, COUNT(*) AS total
FROM NoteEntity
GROUP BY status;

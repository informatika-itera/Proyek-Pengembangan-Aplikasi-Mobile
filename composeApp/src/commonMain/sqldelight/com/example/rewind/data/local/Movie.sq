CREATE TABLE MovieEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    genre TEXT NOT NULL,
    type TEXT NOT NULL,
    status TEXT NOT NULL,
    rating REAL,
    review TEXT NOT NULL,
    synopsis TEXT NOT NULL DEFAULT '',
    totalEpisodes INTEGER,
    watchedEpisodes INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    posterUrl TEXT
);

selectAllMovies:
SELECT * FROM MovieEntity ORDER BY updatedAt DESC;

-- Perhatikan ID huruf besar menyesuaikan buatan Refi
getMovieByID:
SELECT * FROM MovieEntity WHERE id = ?;

getMoviesByStatus:
SELECT * FROM MovieEntity WHERE status = ? ORDER BY updatedAt DESC;

getMoviesByType:
SELECT * FROM MovieEntity WHERE type = ? ORDER BY updatedAt DESC;

getMoviesByGenre:
SELECT * FROM MovieEntity WHERE genre = ? ORDER BY updatedAt DESC;

searchMovies:
SELECT * FROM MovieEntity WHERE title LIKE '%' || ? || '%' ORDER BY updatedAt DESC;

getFavoriteMovies:
SELECT * FROM MovieEntity WHERE rating >= 8.0 ORDER BY updatedAt DESC;

insertMovie:
INSERT INTO MovieEntity(title, genre, type, status, rating, review, synopsis, totalEpisodes, watchedEpisodes, createdAt, updatedAt, posterUrl)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Trik untuk mendapatkan ID yang baru saja dibuat
lastInsertRowId:
SELECT last_insert_rowid();

updateMovie:
UPDATE MovieEntity
SET title = ?, genre = ?, type = ?, status = ?, rating = ?, review = ?, synopsis = ?, totalEpisodes = ?, watchedEpisodes = ?, updatedAt = ?, posterUrl = ?
WHERE id = ?;

deleteMovieById:
DELETE FROM MovieEntity WHERE id = ?;
CREATE TABLE FavoriteEntity (
    kost_id INTEGER PRIMARY KEY NOT NULL
);

getFavorites:
SELECT kost_id FROM FavoriteEntity;

insertFavorite:
INSERT OR REPLACE INTO FavoriteEntity (kost_id) VALUES (?);

deleteFavorite:
DELETE FROM FavoriteEntity WHERE kost_id = ?;

isFavorite:
SELECT COUNT(*) FROM FavoriteEntity WHERE kost_id = ?;

CREATE TABLE TransactionDbEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    amount REAL NOT NULL,
    type TEXT NOT NULL,
    category TEXT NOT NULL,
    date TEXT NOT NULL,
    time TEXT NOT NULL,
    isRecurring INTEGER NOT NULL DEFAULT 0 -- Added recurring field
);

insertTransaction:
INSERT INTO TransactionDbEntity(title, amount, type, category, date, time, isRecurring)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllTransactions:
SELECT * FROM TransactionDbEntity ORDER BY id DESC;

selectTransactionById:
SELECT * FROM TransactionDbEntity WHERE id = ?;

selectTransactionsByType:
SELECT * FROM TransactionDbEntity WHERE type = ?;

updateTransaction:
UPDATE TransactionDbEntity SET title = ?, amount = ?, type = ?, category = ?, date = ?, time = ?, isRecurring = ? WHERE id = ?;

deleteTransaction:
DELETE FROM TransactionDbEntity WHERE id = ?;

CREATE TABLE AiUsageEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    priorityCallsToday INTEGER NOT NULL DEFAULT 0,
    reminderCallsToday INTEGER NOT NULL DEFAULT 0,
    lastResetDate TEXT NOT NULL
);

getUsage:
SELECT * FROM AiUsageEntity WHERE id = 1;

upsertUsage:
INSERT OR REPLACE INTO AiUsageEntity
VALUES (1, ?, ?, ?);

incrementPriority:
UPDATE AiUsageEntity
SET priorityCallsToday = priorityCallsToday + 1
WHERE id = 1;

incrementReminder:
UPDATE AiUsageEntity
SET reminderCallsToday = reminderCallsToday + 1
WHERE id = 1;

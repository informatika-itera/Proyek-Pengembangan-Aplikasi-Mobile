CREATE TABLE PomodoroSessionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    taskId TEXT,
    taskTitle TEXT,
    durationMinutes INTEGER NOT NULL,
    phase TEXT NOT NULL,
    completedAt INTEGER NOT NULL,
    wasCompleted INTEGER NOT NULL DEFAULT 1
);

insertSession:
INSERT INTO PomodoroSessionEntity
VALUES (?, ?, ?, ?, ?, ?, ?);

selectSessionsInRange:
SELECT * FROM PomodoroSessionEntity
WHERE completedAt >= ? AND completedAt < ?
ORDER BY completedAt ASC;

selectTotalFocusMinutesInRange:
SELECT SUM(durationMinutes) AS total
FROM PomodoroSessionEntity
WHERE phase = 'FOCUS'
AND wasCompleted = 1
AND completedAt >= ? AND completedAt < ?;

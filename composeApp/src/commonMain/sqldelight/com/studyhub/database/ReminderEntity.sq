CREATE TABLE ReminderEntity (
    taskId TEXT NOT NULL PRIMARY KEY,
    scheduledAt INTEGER NOT NULL,
    aiReason TEXT NOT NULL,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt INTEGER NOT NULL
);

selectByTaskId:
SELECT * FROM ReminderEntity WHERE taskId = ?;

selectAllActive:
SELECT * FROM ReminderEntity WHERE isActive = 1;

upsert:
INSERT OR REPLACE INTO ReminderEntity
VALUES (?, ?, ?, ?, ?);

deactivate:
UPDATE ReminderEntity
SET isActive = 0 WHERE taskId = ?;

deactivateAll:
UPDATE ReminderEntity SET isActive = 0;

deleteByTaskId:
DELETE FROM ReminderEntity WHERE taskId = ?;

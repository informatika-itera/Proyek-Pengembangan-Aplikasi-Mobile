-- Update UserProfileEntity with new columns
-- We drop and recreate as agreed by user for reset
DROP TABLE IF EXISTS UserProfileEntity;

CREATE TABLE UserProfileEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    email TEXT,
    googleName TEXT,
    googlePhotoUrl TEXT,
    localName TEXT,
    localPhotoPath TEXT,
    nim TEXT NOT NULL DEFAULT '',
    major TEXT NOT NULL DEFAULT '',
    currentStreak INTEGER NOT NULL DEFAULT 0,
    lastStudyDate INTEGER,
    dailyMantra TEXT NOT NULL DEFAULT 'Jangan pernah berhenti belajar, karena hidup tidak pernah berhenti mengajar.'
);

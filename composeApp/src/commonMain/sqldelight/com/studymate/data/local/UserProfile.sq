CREATE TABLE UserProfileEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    email TEXT,
    googleName TEXT,
    googlePhotoUrl TEXT,
    localName TEXT,
    localPhotoPath TEXT,
    nim TEXT NOT NULL DEFAULT '',
    major TEXT NOT NULL DEFAULT '',
    lifeGoals TEXT NOT NULL DEFAULT '',
    currentStreak INTEGER NOT NULL DEFAULT 0,
    lastStudyDate INTEGER,
    dailyMantra TEXT NOT NULL DEFAULT 'Jangan pernah berhenti belajar, karena hidup tidak pernah berhenti mengajar.'
);

insertProfile:
INSERT OR REPLACE INTO UserProfileEntity(id, email, googleName, googlePhotoUrl, localName, localPhotoPath, nim, major, lifeGoals, currentStreak, lastStudyDate, dailyMantra)
VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getProfile:
SELECT * FROM UserProfileEntity WHERE id = 1;

updateLocalProfile:
INSERT INTO UserProfileEntity(id, localName, localPhotoPath, nim, major, lifeGoals)
VALUES (1, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    localName = excluded.localName,
    localPhotoPath = excluded.localPhotoPath,
    nim = excluded.nim,
    major = excluded.major,
    lifeGoals = excluded.lifeGoals;

updateStreak:
UPDATE UserProfileEntity SET currentStreak = ?, lastStudyDate = ? WHERE id = 1;

updateMantra:
UPDATE UserProfileEntity SET dailyMantra = ? WHERE id = 1;

clearProfile:
DELETE FROM UserProfileEntity WHERE id = 1;

CREATE TABLE MediaPageCache (
    cache_key TEXT NOT NULL PRIMARY KEY,
    payload_json TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

getMediaPageCache:
SELECT *
FROM MediaPageCache
WHERE cache_key = ?;

upsertMediaPageCache:
INSERT OR REPLACE INTO MediaPageCache(
    cache_key,
    payload_json,
    cached_at
)
VALUES (?, ?, ?);

clearMediaPageCache:
DELETE FROM MediaPageCache;

CREATE TABLE RelationPreviewCache (
    cache_key TEXT NOT NULL PRIMARY KEY,
    preview_json TEXT NOT NULL,
    cached_at INTEGER NOT NULL
);

getRelationPreviewCache:
SELECT *
FROM RelationPreviewCache
WHERE cache_key = ?;

upsertRelationPreviewCache:
INSERT OR REPLACE INTO RelationPreviewCache(
    cache_key,
    preview_json,
    cached_at
)
VALUES (?, ?, ?);

clearRelationPreviewCache:
DELETE FROM RelationPreviewCache;

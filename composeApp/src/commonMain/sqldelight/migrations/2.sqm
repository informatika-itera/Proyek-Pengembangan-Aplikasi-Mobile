-- Migration from version 1 to 2
-- Add AI cache and usage tracking tables

CREATE TABLE IF NOT EXISTS AiCacheEntity (
    cacheKey TEXT NOT NULL PRIMARY KEY,
    result TEXT NOT NULL,
    promptType TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    expiresAt INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS AiUsageEntity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    priorityCallsToday INTEGER NOT NULL DEFAULT 0,
    reminderCallsToday INTEGER NOT NULL DEFAULT 0,
    lastResetDate TEXT NOT NULL
);


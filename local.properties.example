# local.properties.example
# ================================================
# COPY file ini menjadi `local.properties` di root project,
# kemudian isi nilai-nilai sesuai dengan environment Anda.
#
# JANGAN commit `local.properties` ke repository
# (sudah di-ignore lewat .gitignore).
# ================================================

# Android SDK location (Isi otomatis oleh Studio)
#sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk

# Google Gemini API Key
# Dapatkan di: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyBM9H9uN6jtjHrgZqobyJ6X1CpKqsUx6BY

# Jamendo Client ID (Untuk Streaming Musik)
# Dapatkan di: https://developer.jamendo.com/
# Jika kosong, aplikasi akan menggunakan ID fallback default.
JAMENDO_CLIENT_ID=cbb32072
